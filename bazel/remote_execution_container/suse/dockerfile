FROM opensuse/leap:15.6@sha256:79be7751205ea84559990fb76b1bec71e38d6fad41c70a4f6c921b803b58f421

RUN zypper refresh && \
    zypper install -y --no-recommends \
        cyrus-sasl-devel \
        cyrus-sasl-gssapi \
        glibc-devel \
        krb5-devel \
        libcurl-devel \
        libfl2 \
        libopenssl-devel \
        openldap2-devel \
        zip \
    && zypper clean --all

