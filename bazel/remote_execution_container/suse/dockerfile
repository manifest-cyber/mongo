FROM opensuse/leap:42.3@sha256:271c921a1c84d65467d565e3f1c754b75aa01ceed1a7ac39de4816683c355fd2

RUN zypper refresh && \
    zypper install -y --no-recommends \
        cyrus-sasl-devel \
        cyrus-sasl-gssapi \
        glibc-devel \
        krb5-devel \
        libcurl-devel \
        libfl2 \
        libopenssl-devel \
        openldap2-devel \
        zip \
    && zypper clean --all

CMD ["/bin/bash"]
