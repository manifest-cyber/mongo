FROM redhat/ubi10:10.0@sha256:27251e29658cf10b31914ab9f2630d3f5b0d17d2996ee2dd7d6e2c091a84ab1b

RUN yum check-update || true && \
    yum install -y \
        cyrus-sasl-devel \
        cyrus-sasl-gssapi \
        glibc-devel \
        krb5-devel \
        libcurl-devel \
        openldap-devel \
        openssl-devel \
        systemtap-sdt-devel \
    && yum clean all && rm -rf /var/cache/yum/*

CMD ["/bin/bash"]
